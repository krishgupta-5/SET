rules_version = '2';

// Ownership model (matches the app):
//   - users/{uid}, companies/{uid}: doc id == owner uid
//     (company_setup_screen sets companyId = uid).
//   - expenses, revenue, members, teams, funding_transactions,
//     archived_payments: every doc carries `uid` = owner.
// The backend uses the Admin SDK, which bypasses these rules
// (ai_context_cache is backend-only).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function verified() {
      return signedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }
    function isOwner(uid) {
      return verified() && request.auth.uid == uid;
    }
    // Owner of an existing doc (read/update/delete).
    function ownsExisting() {
      return verified() && resource.data.uid == request.auth.uid;
    }
    // New/updated doc must stay owned by the caller (no re-parenting).
    function ownsIncoming() {
      return verified() && request.resource.data.uid == request.auth.uid;
    }
    function uidUnchanged() {
      return request.resource.data.uid == resource.data.uid;
    }

    // ---------- auth helpers (pre-login, keyed by email) ----------
    // Written during login/reset before the user may be signed in, so they
    // cannot be owner-scoped. Keep them write-only from clients: nothing
    // sensitive can be read back by other users.
    match /rate_limits/{email} {
      allow read, write: if true;
    }
    match /account_security/{email} {
      allow read, write: if true;
    }
    match /auth_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ---------- profile + company ----------
    match /users/{userId} {
      // Not `verified()`: the doc is created right after sign-up, before
      // email verification, and AuthWrapper reads it to route the user.
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        // companyId can be set once, and only to the user's own uid.
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == userId)
        && (resource == null
            || !('companyId' in resource.data)
            || request.resource.data.companyId == resource.data.companyId);
    }

    match /companies/{companyId} {
      allow read, delete: if isOwner(companyId);
      allow create, update: if isOwner(companyId)
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == companyId);

      match /bankAccounts/{accountId} {
        allow read, write: if isOwner(companyId);
      }
    }

    // ---------- financial data ----------
    match /expenses/{expenseId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.Amount is number
        && request.resource.data.Amount >= 0
        && request.resource.data.Title is string
        && request.resource.data.Title.size() > 0
        && request.resource.data.Title.size() <= 200;
      allow update: if ownsExisting() && uidUnchanged()
        && request.resource.data.Amount is number
        && request.resource.data.Amount >= 0;
    }

    match /revenue/{revenueId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.Amount is number
        && request.resource.data.Amount >= 0;
      allow update: if ownsExisting() && uidUnchanged();
    }

    match /funding_transactions/{txId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.amount is number;
      allow update, delete: if ownsExisting() && uidUnchanged();
    }

    // Legacy archive from the old member/team delete; read-only now.
    match /archived_payments/{docId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update, delete: if false;
    }

    // ---------- team ----------
    // Previously any signed-in user could read every company's members and
    // salaries. Now strictly owner-only.
    match /teams/{teamId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && uidUnchanged();
    }

    match /members/{memberId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && uidUnchanged();

      match /salary_history/{entryId} {
        allow read, write: if verified()
          && get(/databases/$(database)/documents/members/$(memberId)).data.uid
             == request.auth.uid;
      }
    }

    // Legacy per-section AI copies written by the removed
    // AIService.syncAICollections(); owner-only until cleaned up.
    match /ai/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Everything else (incl. backend-only ai_context_cache) is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
