# Copy to backend/.env for local development. Never commit real values.
# On Render, set these as environment variables instead.

# --- AI ---
GROQ_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# --- File storage (Telegram; the app never sees this token) ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=-1003885930746

# --- Firebase Admin (one of these) ---
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Security ---
# Unverified-token fallback. ONLY for local dev; leave unset in production.
# DEBUG_MODE=true
# Comma-separated browser origins (only needed for Flutter web).
# ALLOWED_ORIGINS=https://your-web-app.example
# AI_RATE_LIMIT_PER_MIN=30
